# Full agent event logs can contain sensitive conversation and integration data.
# Set this to 1 only during targeted debugging.
# AGENT_DEBUG_LOGS=1

# Public origin used by the Slack app manifest.
BASE_URL=https://sketch.manasijatech.com

# Direct Slack HTTP Events API credentials. Copy these after installing the
# app from app.manifest.yaml. Keep both values secret.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me

# Recommended Eve alternative on Vercel: use a Slack Vercel Connect client.
# When set, SLACK_CONNECTOR takes precedence over the two direct values above.
# SLACK_CONNECTOR=slack/my-agent
# One-time bootstrap defaults; managers can change these later through chat.
SLACK_DAILY_UPDATES_CHANNEL_ID=C0123456789

# Slack-to-GitHub issue tracking. The persistent runtime must have the gh CLI
# installed. GH_TOKEN should belong to a dedicated identity with issue write
# access only to repositories Furgo may route to.
GH_TOKEN=ghp-replace-me
ISSUE_ROUTING_CHANNEL_ID=C0BPD515TB4

# One-time bootstrap roster. Employees participate in stand-ups. Managers can
# manage any employee/date and change this roster or the updates channel in chat.
# Use employee_manager when a manager should also submit stand-ups.
STANDUP_ROSTER_JSON=[{"slackUserId":"U0123456789","displayName":"Alice","role":"employee"},{"slackUserId":"U9876543210","displayName":"Mina","role":"manager"}]

# Omit these locally to use file:standup.sqlite. They are required on Vercel.
TURSO_DATABASE_URL=libsql://replace-me.turso.io
TURSO_AUTH_TOKEN=replace-me
